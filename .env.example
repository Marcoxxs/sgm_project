# Configuração pública do Firebase usada pelo frontend (Vite).
# Copie os valores de Configurações do projeto > Seus apps > Web no console do Firebase.
# Preencha em .env.local. Esse arquivo é apenas um modelo e não deve conter valores reais.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: emuladores locais do Firebase Emulator Suite para desenvolvimento e testes.
# Mantenha vazio em produção.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=
